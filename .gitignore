central_ocr_seen.json
line_db_cursor.json
line_message_ledger.sqlite3

# 字型原檔 48 MB，不進版控。要重建子集時自己抓：
#   curl -sL -o vendor/ChironHeiHKVF.ttf \
#     https://raw.githubusercontent.com/chiron-fonts/chiron-hei-hk/master/VAR_TTF/ChironHeiHKVF.ttf
# 產出的子集（website/assets/fonts/*.woff2）才是要提交的東西。
vendor/*.ttf

# 市場歷史快照（K 線資料，體積大且可重新匯出，不進版控）
data/market_history/
# 縮時素材是產生出來的，一支 GIF 就 1.6 MB，不進版控
data/replays/
data/recordings/
data/android/

# 執行期資料與抓下來的素材（129MB 起跳：APK、截圖、strace、MT5 日誌、K 線快取）
# 這個 repo 是公開的，裡面有帳號號碼與交易紀錄，一律不進版控。
data/

# npm（這個 repo 只有官網用得到，裝出來的東西不需要版控）
node_modules/
